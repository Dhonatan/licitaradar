#!/usr/bin/env ruby
require "rubygems"
require "bundler/setup"

# By default fail when Brakeman itself is outdated; `--no-ensure-latest` skips that check
# (CI uses it so a new Brakeman release can't break unrelated builds).
if ARGV.delete("--no-ensure-latest").nil?
  ARGV.unshift("--ensure-latest")
end

load Gem.bin_path("brakeman", "brakeman")
