# Keep the build context small and secrets out of the image. See Dockerfile.

/.git/
/.github/
/.gitignore

# Secrets and local environment
/.env*
/config/master.key
/config/credentials/*.key

# Local data, logs and build output
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/storage/*
!/storage/.keep
/public/assets
/vendor/bundle
/coverage

# Not needed at runtime
/test/
/docs/
/Dockerfile
/.dockerignore
/.rubocop.yml
