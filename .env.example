# Copy to .env (never commit .env). All values below are placeholders.

# Database (development / test)
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Production
DATABASE_URL=postgres://user:password@host:5432/licitaradar_production
SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret
APP_HOST=licitaradar.example.com

# E-mail (password resets, daily digest). Without SMTP_ADDRESS no e-mail is delivered.
MAIL_FROM="LicitaRadar <alertas@licitaradar.example.com>"
SMTP_ADDRESS=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=replace-me
# Who gets operational alerts (e.g. the PNCP sync keeps failing). Comma-separated.
ADMIN_EMAIL=ops@licitaradar.example.com

# Admin status page /status (HTTP basic auth). Leave unset to disable the page (404).
STATUS_USERNAME=admin
STATUS_PASSWORD=replace-with-a-long-random-password

# Background jobs: run Solid Queue (sync every 6h, digest at 07:00) inside Puma.
# Leave unset if you run `bin/jobs` as a separate process instead.
SOLID_QUEUE_IN_PUMA=1
JOB_CONCURRENCY=1

# PNCP public API (no key needed). Override only for testing against a mock.
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
