# Copy to .env (never commit .env). All values below are placeholders.

# Database (development / test)
DB_HOST=localhost
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Production
DATABASE_URL=postgres://user:password@host:5432/licitaradar_production
SECRET_KEY_BASE=replace-with-output-of-bin-rails-secret
APP_HOST=licitaradar.example.com

# PNCP public API (no key needed). Override only for testing against a mock.
PNCP_BASE_URL=https://pncp.gov.br/api/consulta
