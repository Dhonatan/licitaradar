<% content_for :title, "Nova senha — LicitaRadar" %>

<section class="auth-card">
  <h1 class="page-title">Crie uma nova senha</h1>

  <%= render "shared/form_errors", record: @user %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "stacked-form" do |form| %>
    <div class="field">
      <%= form.label :password, "Nova senha" %>
      <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password",
                                         minlength: User::MIN_PASSWORD_LENGTH, maxlength: 72 %>
      <span class="hint">Pelo menos <%= User::MIN_PASSWORD_LENGTH %> caracteres.</span>
    </div>

    <div class="field">
      <%= form.label :password_confirmation, "Repita a nova senha" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>

    <div class="form-actions">
      <%= form.submit "Salvar nova senha", class: "button" %>
    </div>
  <% end %>
</section>
