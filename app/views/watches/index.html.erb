<% content_for :title, "Minhas licitações — LicitaRadar" %>

<div class="page-header">
  <h1 class="page-title">Minhas licitações</h1>
  <%= link_to "Buscar licitações", tenders_path, class: "button button--secondary" %>
</div>

<% if @watches.any? %>
  <ol class="tender-list watch-list">
    <% @watches.each do |watch| %>
      <% tender = watch.tender %>
      <li class="tender-card" id="<%= dom_id(watch) %>">
        <div class="tender-card__meta">
          <%= proposals_status_badge(tender) %>
          <% if tender.proposals_close_at %>
            <span class="muted">
              <%= tender.open_for_proposals? ? "Propostas até" : "Encerrou em" %>
              <time datetime="<%= tender.proposals_close_at.iso8601 %>"><%= date_time_br(tender.proposals_close_at) %></time>
            </span>
          <% end %>
          <span class="muted"><%= tender_modality(tender) %></span>
        </div>
        <h2 class="tender-card__title">
          <%= link_to (tender.object_description.presence || "Objeto não informado").truncate(220), tender_path(tender) %>
        </h2>
        <p class="muted">
          <%= tender.agency_name %>
          <% if (location = tender_location(tender)) %>· <%= location %><% end %>
        </p>
        <p class="tender-card__value"><%= tender_value(tender) %></p>
        <%= render "watches/notes/note", watch: watch %>
        <div class="tender-card__actions">
          <%= render "watches/button", tender: tender, watch: watch %>
        </div>
      </li>
    <% end %>
  </ol>
  <p class="muted small">Você pode acompanhar até <%= Watch::MAX_PER_USER %> licitações. As encerradas continuam aqui até você removê-las.</p>
<% else %>
  <div class="empty-state">
    <p>Você ainda não acompanha nenhuma licitação.</p>
    <p class="muted">Clique em “Acompanhar” numa licitação para vê-la aqui, com o prazo sempre à vista.</p>
    <p><%= link_to "Buscar licitações", tenders_path, class: "button" %></p>
  </div>
<% end %>

<section class="card calendar-feed" id="calendar">
  <h2>Prazos no seu calendário</h2>
  <p>
    Assine o endereço abaixo no Google Agenda, no Outlook ou no Calendário da Apple para ver o fim do prazo de propostas
    das licitações que você acompanha. O calendário se atualiza sozinho (os aplicativos buscam as mudanças algumas vezes por dia).
  </p>
  <% if (token = Current.user.calendar_token).present? %>
    <p><code class="calendar-feed__url"><%= calendar_feed_url(token) %></code></p>
    <div class="actions">
      <%= link_to "Assinar no calendário", calendar_feed_url(token, protocol: "webcal"), class: "button button--small" %>
      <%= button_to "Gerar novo link", calendar_token_path, class: "link-button", form_class: "inline-form",
                    form: { data: { turbo_confirm: "O link atual vai parar de funcionar. Gerar um novo?" } } %>
    </div>
    <p class="muted small">O link é secreto: quem tiver o endereço vê quais licitações você acompanha (as notas nunca aparecem). Se ele vazar, gere um novo.</p>
  <% else %>
    <%= button_to "Gerar link do calendário", calendar_token_path, class: "button button--secondary button--small" %>
  <% end %>
</section>
